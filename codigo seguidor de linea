const int STBY = 3;
const int BIN1 = 4;
const int BIN2 = 6;
const int AIN1 = 7;
const int AIN2 = 8;
const int PWMA = 9;
const int PWMB = 10;
const int PULSADOR = 12;
const int LED = 13;

const int NUM_SENSORES = 5;
const int pinesSensor[NUM_SENSORES] = {A0, A1, A2, A3, A4};

const bool LINEA_NEGRA = true;
const int VEL_BASE = 150;
const int VEL_MAX = 230;
const int UMBRAL_LINEA = 300;

float Kp = 0.045;
float Ki = 0.0;
float Kd = 0.55;

int minimo[NUM_SENSORES];
int maximo[NUM_SENSORES];

float integral = 0;
int errorAnterior = 0;
int ultimaPosicion = 2000;
bool corriendo = false;

void motorDerecho(int vel) {
  vel = constrain(vel, -VEL_MAX, VEL_MAX);
  digitalWrite(AIN1, vel > 0 ? HIGH : LOW);
  digitalWrite(AIN2, vel < 0 ? HIGH : LOW);
  analogWrite(PWMA, abs(vel));
}

void motorIzquierdo(int vel) {
  vel = constrain(vel, -VEL_MAX, VEL_MAX);
  digitalWrite(BIN1, vel > 0 ? HIGH : LOW);
  digitalWrite(BIN2, vel < 0 ? HIGH : LOW);
  analogWrite(PWMB, abs(vel));
}

void detener() {
  motorDerecho(0);
  motorIzquierdo(0);
}

void calibrar() {
  for (int i = 0; i < NUM_SENSORES; i++) {
    minimo[i] = 1023;
    maximo[i] = 0;
  }

  unsigned long inicio = millis();
  while (millis() - inicio < 4000) {
    digitalWrite(LED, (millis() / 100) % 2);
    for (int i = 0; i < NUM_SENSORES; i++) {
      int lectura = analogRead(pinesSensor[i]);
      if (lectura < minimo[i]) minimo[i] = lectura;
      if (lectura > maximo[i]) maximo[i] = lectura;
    }
  }
  digitalWrite(LED, LOW);
}

int leerPosicion() {
  long suma = 0;
  long sumaPonderada = 0;

  for (int i = 0; i < NUM_SENSORES; i++) {
    int lectura = analogRead(pinesSensor[i]);
    int rango = maximo[i] - minimo[i];
    if (rango < 1) continue;

    int valor = map(lectura, minimo[i], maximo[i], 0, 1000);
    valor = constrain(valor, 0, 1000);
    if (!LINEA_NEGRA) valor = 1000 - valor;

    if (valor > UMBRAL_LINEA) {
      sumaPonderada += (long)valor * i * 1000;
      suma += valor;
    }
  }

  if (suma == 0) return -1;
  return sumaPonderada / suma;
}

void seguirLinea() {
  int posicion = leerPosicion();

  if (posicion == -1) {
    if (ultimaPosicion < 2000) {
      motorDerecho(VEL_BASE);
      motorIzquierdo(-VEL_BASE);
    } else {
      motorDerecho(-VEL_BASE);
      motorIzquierdo(VEL_BASE);
    }
    return;
  }

  ultimaPosicion = posicion;

  int error = posicion - 2000;
  integral += error;
  integral = constrain(integral, -3000, 3000);
  int derivada = error - errorAnterior;
  errorAnterior = error;

  float correccion = Kp * error + Ki * integral + Kd * derivada;

  motorIzquierdo(VEL_BASE + correccion);
  motorDerecho(VEL_BASE - correccion);
}

bool pulsadorApretado() {
  if (digitalRead(PULSADOR) == LOW) {
    delay(30);
    if (digitalRead(PULSADOR) == LOW) {
      while (digitalRead(PULSADOR) == LOW) { }
      delay(30);
      return true;
    }
  }
  return false;
}

void setup() {
  pinMode(STBY, OUTPUT);
  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);
  pinMode(PWMB, OUTPUT);
  pinMode(LED, OUTPUT);
  pinMode(PULSADOR, INPUT_PULLUP);

  digitalWrite(STBY, HIGH);
  detener();

  while (!pulsadorApretado()) { }
  calibrar();

  while (!pulsadorApretado()) {
    digitalWrite(LED, HIGH);
  }
  digitalWrite(LED, LOW);
  delay(500);
  corriendo = true;
}

void loop() {
  if (pulsadorApretado()) {
    corriendo = !corriendo;
    detener();
    integral = 0;
    errorAnterior = 0;
    delay(300);
  }

  if (corriendo) {
    seguirLinea();
  }
}
